@{
    Layout = null; // Standalone authentication screen matching JingYi design system
    ViewData["Title"] = "Register - JingYi Public Library";
    var roles = ViewBag.Roles as List<PULibrary.Models.Role> ?? new();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .jy-auth-container {
            display: flex;
            min-height: 100vh;
            background-color: var(--jy-canvas-bg);
            width: 100%;
        }
        .jy-auth-left {
            flex: 1 1 50%;
            width: 50%;
            min-width: 380px;
            background-color: #275b46;
            background: linear-gradient(135deg, #1b3e30 0%, #275b46 100%);
            color: #fffdf8;
            padding: clamp(40px, 5vw, 72px) clamp(36px, 5vw, 64px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        .jy-auth-left-inner {
            width: 100%;
            max-width: 500px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100%;
            position: relative;
            z-index: 1;
        }
        .jy-auth-left::after {
            content: "";
            position: absolute;
            bottom: -50px;
            right: -50px;
            width: 340px;
            height: 340px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212, 220, 201, 0.15) 0%, rgba(212, 220, 201, 0) 70%);
            pointer-events: none;
        }
        .jy-auth-right {
            flex: 1 1 50%;
            width: 50%;
            min-width: 380px;
            padding: clamp(40px, 5vw, 72px) clamp(32px, 5vw, 64px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: var(--jy-canvas-bg);
            overflow-y: auto;
        }
        .jy-auth-right-inner {
            width: 100%;
            max-width: 500px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 100%;
        }
        .jy-auth-form-card {
            width: 100%;
            margin: clamp(20px, 3vh, 36px) 0;
        }
        .jy-editorial-title {
            font-family: var(--font-heading);
            font-size: 46px;
            line-height: 1.18;
            color: #fffdf8;
            margin: 20px 0;
        }
        .jy-editorial-rule {
            width: 64px;
            height: 2px;
            background-color: #d4dcc9;
            margin-bottom: 24px;
        }
        .jy-brand-wordmark {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .jy-brand-wordmark .jy-title {
            font-family: var(--font-heading);
            font-size: 25px;
            color: #fffdf8;
            line-height: 1.25;
            letter-spacing: 0.02em;
        }
        .jy-brand-wordmark .jy-sub {
            font-size: 12px;
            font-weight: 700;
            color: #d4dcc9;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .jy-auth-right .jy-form-control {
            height: 46px;
            font-size: 15px;
        }
        .jy-auth-right .jy-form-control::placeholder {
            color: #8c9389 !important;
            opacity: 0.45 !important;
            font-weight: 400 !important;
            font-size: 14.5px;
        }
        .jy-btn-outline {
            height: 44px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none !important;
            border: 1.5px solid var(--jy-primary-green);
            border-radius: 6px;
            background-color: #fffdf8;
            color: var(--jy-primary-green) !important;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }
        .jy-btn-outline:hover {
            background-color: #e8eee8;
            color: #1b3e30 !important;
            border-color: #1b3e30;
            transform: translateY(-1px);
        }
        .jy-role-select {
            display: flex;
            gap: 12px;
            margin-top: 6px;
        }
        .jy-role-option {
            flex: 1;
            border: 1px solid var(--jy-border);
            border-radius: 8px;
            padding: 10px 14px;
            cursor: pointer;
            background-color: #fffdf8;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.15s ease;
        }
        .jy-role-option:hover {
            border-color: var(--jy-primary-green);
        }
        .jy-role-option input[type="radio"] {
            accent-color: var(--jy-primary-green);
        }
        @@media (max-width: 900px) {
            .jy-auth-container {
                flex-direction: column;
            }
            .jy-auth-left {
                width: 100%;
                min-width: 100%;
                padding: 40px 32px;
            }
            .jy-auth-right {
                width: 100%;
                min-width: 100%;
                padding: 40px 32px;
            }
            .jy-auth-left-inner,
            .jy-auth-right-inner {
                max-width: 100%;
            }
        }
    </style>
</head>
<body class="jy-app-body">
    <div class="jy-auth-container">
        <!-- Left Hero Section (matching JingYi design tokens) -->
        <div class="jy-auth-left">
            <div class="jy-auth-left-inner">
                <!-- Brand -->
                <div class="d-flex align-items-center gap-3">
                    <div class="jy-brand-logo" style="background: rgba(255,255,255,0.12); border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fffdf8" stroke-width="2">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                        </svg>
                    </div>
                    <div class="jy-brand-wordmark">
                        <span class="jy-title">JingYi</span>
                        <span class="jy-sub">PUBLIC LIBRARY</span>
                    </div>
                </div>

                <!-- Welcome Editorial -->
                <div>
                    <div style="font-size: 13px; font-weight: 700; color: #d4dcc9; letter-spacing: 0.1em;">JOIN THE COMMUNITY</div>
                    <div class="jy-editorial-title">
                        Read broadly.<br />
                        Discover deeply.<br />
                        Belong to JingYi.
                    </div>
                    <div class="jy-editorial-rule"></div>
                    <p style="font-size: 17px; color: #d4dcc9; max-width: 480px; line-height: 1.5;">
                        Create your library card to borrow physical copies, place reservations on sought-after titles, and keep track of your reading journey.
                    </p>
                </div>

                <div style="font-size: 13px; color: #d4dcc9; letter-spacing: 0.06em; font-weight: 500;">
                    JINGYI PUBLIC LIBRARY &nbsp; / &nbsp; READER REGISTRATION
                </div>
            </div>
        </div>

        <!-- Right Form Section -->
        <div class="jy-auth-right">
            <div class="jy-auth-right-inner">
                <!-- Header badge -->
                <div class="d-flex align-items-center gap-2" style="color: var(--jy-primary-green);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span style="font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em;">READER CARD MEMBERSHIP &amp; ACCESS</span>
                </div>

                <!-- Form block -->
                <div class="jy-auth-form-card">
                    <h1 style="font-family: var(--font-heading); font-size: 38px; color: var(--jy-primary-dark); margin-bottom: 8px;">Join JingYi Library</h1>
                    <p style="font-size: 16px; color: var(--jy-text-muted); margin-bottom: 20px;">Create your reader card to begin borrowing books.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div style="background-color: var(--jy-badge-red-bg); border-left: 3px solid var(--jy-badge-red-text); border-radius: 6px; padding: 14px 16px; margin-bottom: 18px; color: var(--jy-badge-red-text);">
                            <div style="font-weight: 600; font-size: 14.5px;">Registration could not be completed.</div>
                            <div style="font-size: 13.5px;">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@err.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <form asp-action="Register" method="post" class="d-flex flex-column gap-3">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Full name <span class="text-danger">*</span></label>
                                <input type="text" name="name" required maxlength="30" class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="Enter full name" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Username <span class="text-danger">*</span></label>
                                <input type="text" name="username" required maxlength="20" class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="Enter username" />
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Email address</label>
                                <input type="email" name="email" maxlength="100" class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="Enter email address" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Phone number</label>
                                <input type="tel" name="phone" maxlength="10" class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="10-digit number" />
                            </div>
                        </div>

                        <div>
                            <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Reader account type</label>
                            <div class="jy-role-select">
                                <label class="jy-role-option">
                                    <input type="radio" name="roleId" value="1" checked />
                                    <div>
                                        <div style="font-size: 14px; font-weight: 600; color: var(--jy-primary-dark);">Member</div>
                                        <div style="font-size: 13px; color: #525c4e;">Standard reader borrowing</div>
                                    </div>
                                </label>
                                <label class="jy-role-option">
                                    <input type="radio" name="roleId" value="2" />
                                    <div>
                                        <div style="font-size: 14px; font-weight: 600; color: var(--jy-primary-dark);">Researcher</div>
                                        <div style="font-size: 13px; color: #525c4e;">Extended loan privileges</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Password <span class="text-danger">*</span></label>
                                <input type="password" name="password" required class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="Enter password" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="jy-form-label" style="font-size: 14.5px; font-weight: 600; margin-bottom: 6px;">Confirm password <span class="text-danger">*</span></label>
                                <input type="password" name="confirmPassword" required class="form-control jy-form-control" style="height: 46px; font-size: 15px;" placeholder="Re-enter password" />
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-3 pt-2">
                            <a asp-action="SignIn" class="jy-btn-outline">
                                ← Back to Sign in
                            </a>
                            <button type="submit" class="jy-btn-primary" style="height: 44px; padding: 0 28px; font-size: 14.5px; font-weight: 600;">Register reader card →</button>
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div style="font-size: 13.5px; color: #525c4e;">
                    Authorized readers only. Reader information is private and protected.
                </div>
            </div>
        </div>
    </div>
</body>
</html>

@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JingYi Public Library</title>
    <!-- Google Fonts: Lora (headings) & Source Sans 3 (UI body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom Figma Design System Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="jy-app-body">
    @{
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Dashboard";
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";

        string userName = Context.Session.GetString("UserName") ?? "Jamie Lee";
        string userRole = Context.Session.GetString("UserRole") ?? "Admin · Role 4";
        int userId = Context.Session.GetInt32("UserId") ?? 1001;
        string initials = string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
        if (string.IsNullOrEmpty(initials)) initials = "JL";
        bool isStaff = userRole.Contains("Admin") || userRole.Contains("Librarian");
    }

    <div class="jy-app-container">
        <!-- Sidebar Navigation -->
        <aside class="jy-sidebar">
            <div class="jy-brand-block">
                <div class="jy-brand-logo">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#243a32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                    </svg>
                </div>
                <div class="jy-brand-text">
                    <span class="jy-brand-title">JingYi</span>
                    <span class="jy-brand-subtitle">PUBLIC LIBRARY</span>
                </div>
            </div>

            @if (currentController == "Admin")
            {
                <!-- LIBRARIAN STAFF WORKSPACE SECTION (Admin UI) -->
                <div class="jy-nav-section">
                    <div class="jy-nav-group-label">LIBRARIAN WORKSPACE</div>

                    <nav class="jy-nav-menu">
                        <a asp-controller="Admin" asp-action="Dashboard" class="jy-nav-item @(currentAction == "Dashboard" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                            </span>
                            <span class="jy-nav-text">Dashboard</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Books" class="jy-nav-item @(currentAction == "Books" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                            </span>
                            <span class="jy-nav-text">Book catalog</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Copies" class="jy-nav-item @(currentAction == "Copies" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
                            </span>
                            <span class="jy-nav-text">Copies</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Loans" class="jy-nav-item @(currentAction == "Loans" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="16" height="14" rx="2"></rect><path d="M16 3H4a2 2 0 0 0-2 2v14"></path></svg>
                            </span>
                            <span class="jy-nav-text">Loans</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Circulation" class="jy-nav-item @(currentAction == "Circulation" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path></svg>
                            </span>
                            <span class="jy-nav-text">Circulation desk</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Reservations" class="jy-nav-item @(currentAction == "Reservations" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path></svg>
                            </span>
                            <span class="jy-nav-text">Reservations</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Users" class="jy-nav-item @(currentAction == "Users" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </span>
                            <span class="jy-nav-text">Users</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Policies" class="jy-nav-item @(currentAction == "Policies" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" x2="14" y1="4" y2="4"></line><line x1="10" x2="3" y1="4" y2="4"></line><line x1="21" x2="12" y1="12" y2="12"></line><line x1="8" x2="3" y1="12" y2="12"></line><line x1="21" x2="16" y1="20" y2="20"></line><line x1="12" x2="3" y1="20" y2="20"></line><line x1="14" x2="14" y1="2" y2="6"></line><line x1="8" x2="8" y1="10" y2="14"></line><line x1="16" x2="16" y1="18" y2="22"></line></svg>
                            </span>
                            <span class="jy-nav-text">Roles & policies</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Metadata" class="jy-nav-item @(currentAction == "Metadata" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path><path d="M7 7h.01"></path></svg>
                            </span>
                            <span class="jy-nav-text">Catalog metadata</span>
                        </a>
                    </nav>

                    <div class="mt-3 px-2">
                        <a asp-controller="Catalog" asp-action="Index" class="jy-btn-secondary w-100 justify-content-center" style="font-size: 12px; padding: 6px 10px;">
                            View Reader Portal ↗
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- READER PORTAL SECTION (User UI) -->
                <div class="jy-nav-section">
                    <div class="jy-nav-group-label">READER PORTAL</div>
                    <nav class="jy-nav-menu">
                        <a asp-controller="Catalog" asp-action="Index" class="jy-nav-item @(currentController == "Catalog" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            </span>
                            <span class="jy-nav-text">Browse catalog</span>
                        </a>

                        <a asp-controller="User" asp-action="Profile" asp-route-id="@userId" class="jy-nav-item @(currentController == "User" ? "active" : "")">
                            <span class="jy-nav-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            </span>
                            <span class="jy-nav-text">My loans &amp; history</span>
                        </a>
                    </nav>

                    @if (isStaff)
                    {
                        <div class="mt-3 px-2">
                            <a asp-controller="Admin" asp-action="Dashboard" class="jy-btn-primary w-100 justify-content-center" style="font-size: 12px; padding: 6px 10px;">
                                Librarian Workspace →
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- Workspace Guide Card -->
            <div class="jy-workspace-guide-card">
                <div class="jy-guide-title">A place for every reader.</div>
                <div class="jy-guide-desc">Collection, circulation and people, connected.</div>
                <a asp-controller="Catalog" asp-action="Index" class="jy-guide-link">Discover collection →</a>
            </div>

            <div class="jy-nav-spacer"></div>

            <!-- Active User Account Profile Card -->
            <div class="jy-account-card">
                <div class="jy-avatar">@initials</div>
                <div class="jy-account-info">
                    <div class="jy-account-name">@userName</div>
                    <div class="jy-account-role">@userRole</div>
                    <div class="jy-account-meta d-flex gap-2">
                        <a asp-controller="User" asp-action="Profile" asp-route-id="@userId" style="color: inherit; text-decoration: underline;">Profile &amp; Settings</a>
                        <span>·</span>
                        <a asp-controller="Account" asp-action="SignIn" style="color: inherit; text-decoration: underline;">Switch user</a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace Area -->
        <main class="jy-workspace-main">
            <!-- Utility Bar -->
            <header class="jy-utility-bar">
                <div class="jy-breadcrumb">
                    <span>JingYi Public Library</span>
                    <span class="jy-breadcrumb-separator">/</span>
                    <span>@(currentController == "Admin" ? "Librarian workspace" : "Reader portal")</span>
                    <span class="jy-breadcrumb-separator">/</span>
                    <span class="jy-breadcrumb-current">@(ViewData["Title"] ?? "Dashboard")</span>
                </div>
                <div class="jy-session-details">
                    <span class="jy-session-time">@DateTime.Now.ToString("dddd, dd MMMM yyyy · HH:mm")</span>
                    <span class="jy-session-divider"></span>
                    <span class="jy-session-badge">@initials · @userRole</span>
                    @if (currentController == "Admin")
                    {
                        <a asp-controller="Catalog" asp-action="Index" class="jy-btn-secondary ms-2" style="font-size: 11px; padding: 3px 8px;">Reader UI ↗</a>
                    }
                    else if (isStaff)
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="jy-btn-secondary ms-2" style="font-size: 11px; padding: 3px 8px;">Admin UI →</a>
                    }
                    <a asp-controller="Account" asp-action="SignIn" class="jy-btn-secondary ms-2" style="font-size: 11px; padding: 3px 8px;">Switch user</a>
                </div>
            </header>

            <!-- Alerts / Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="jy-alert jy-alert-success">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="jy-alert jy-alert-error">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <!-- Page Content -->
            <div class="jy-page-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model List<PULibrary.Models.User>
@{
    ViewData["Title"] = "Users";
}

<div class="jy-page-heading">
    <div class="jy-section-label">MEMBERSHIP / ACCOUNTS</div>
    <div class="jy-title-row">
        <h1 class="jy-page-title">Users and role assignments.</h1>
        <a asp-action="Policies" class="jy-btn-secondary">Borrowing policies →</a>
    </div>
    <div class="jy-page-subtitle">Registered readers and library staff, role assignments and active borrow balances.</div>
</div>

<div class="jy-panel">
    <div class="jy-panel-header">
        <div>
            <div class="jy-panel-heading-title">Registered readers and staff</div>
            <div class="jy-panel-heading-desc">@Model.Count user accounts enrolled</div>
        </div>
    </div>

    <div class="jy-table-container">
        <table class="jy-table">
            <thead>
                <tr>
                    <th style="width: 12%;">USER ID</th>
                    <th style="width: 23%;">NAME & USERNAME</th>
                    <th style="width: 16%;">ROLE</th>
                    <th style="width: 19%;">CONTACT</th>
                    <th style="width: 10%;">ACTIVE LOANS</th>
                    <th style="width: 10%;">STATUS</th>
                    <th style="width: 10%;">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var allRoles = ViewBag.Roles as List<PULibrary.Models.Role> ?? new();
                }
                @foreach (var user in Model)
                {
                    int activeCount = user.Loans.Count(l => l.ReturnedAt == null);
                    short maxLoans = user.Role?.Policy?.MaxLoans ?? 0;
                    <tr>
                        <td style="font-weight: 600; font-size: 14px; color: var(--jy-primary-dark);">
                            #@user.UserId
                        </td>
                        <td>
                            <div style="font-weight: 600; font-size: 14px; color: var(--jy-primary-dark);">@user.Name</div>
                            <div style="font-size: 12px; color: var(--jy-text-muted);">@@@user.Username</div>
                        </td>
                        <td>
                            <div style="font-weight: 600; color: var(--jy-primary-green);">@user.Role?.RoleName</div>
                            <div style="font-size: 11px; color: var(--jy-text-muted);">Role @user.RoleId</div>
                        </td>
                        <td>
                            <div style="font-size: 13px; color: var(--jy-primary-dark);">@user.Email</div>
                            <div style="font-size: 12px; color: var(--jy-text-muted);">Phone: @user.Phone</div>
                        </td>
                        <td>
                            <span style="font-weight: 600; color: @(activeCount >= maxLoans ? "var(--jy-badge-red-text)" : "var(--jy-primary-dark)");">
                                @activeCount / @maxLoans
                            </span>
                            <span style="font-size: 11px; color: var(--jy-text-muted);">allowed</span>
                        </td>
                        <td>
                            @if (user.Status == "Active")
                            {
                                <span class="jy-badge jy-badge-available">
                                    <span class="jy-badge-dot"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="jy-badge jy-badge-overdue">
                                    <span class="jy-badge-dot"></span> Suspended
                                </span>
                            }
                        </td>
                        <td>
                            <button type="button" class="jy-btn-secondary" style="font-size: 11px; padding: 3px 8px;" data-bs-toggle="modal" data-bs-target="#editUserModal-@user.UserId">
                                Edit ✎
                            </button>

                            <!-- Edit Modal for this User -->
                            <div class="modal fade" id="editUserModal-@user.UserId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content" style="background-color: var(--jy-panel-bg); border: 1px solid var(--jy-border); border-radius: 8px;">
                                        <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 16px 20px;">
                                            <div>
                                                <h5 class="modal-title" style="font-family: var(--font-heading); font-size: 18px; color: var(--jy-primary-dark); margin: 0;">
                                                    Edit Account: @user.Name
                                                </h5>
                                                <div style="font-size: 12px; color: var(--jy-text-muted);">User #@user.UserId · @@@user.Username</div>
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <form asp-action="UpdateUser" method="post">
                                            <input type="hidden" name="userId" value="@user.UserId" />
                                            <div class="modal-body d-flex flex-column gap-3" style="padding: 20px;">
                                                <div>
                                                    <label class="jy-form-label" style="font-size: 13px;">Full name *</label>
                                                    <input type="text" name="name" value="@user.Name" required maxlength="30" class="form-control jy-form-control" />
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-7">
                                                        <label class="jy-form-label" style="font-size: 13px;">Email address *</label>
                                                        <input type="email" name="email" value="@user.Email" required maxlength="100" class="form-control jy-form-control" />
                                                    </div>
                                                    <div class="col-md-5">
                                                        <label class="jy-form-label" style="font-size: 13px;">Phone number *</label>
                                                        <input type="tel" name="phone" value="@user.Phone" required maxlength="10" class="form-control jy-form-control" />
                                                    </div>
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-6">
                                                        <label class="jy-form-label" style="font-size: 13px;">Account status</label>
                                                        <select name="status" class="form-select jy-form-control">
                                                            <option value="Active" selected="@(user.Status == "Active")">Active</option>
                                                            <option value="Suspended" selected="@(user.Status != "Active")">Suspended</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="jy-form-label" style="font-size: 13px;">Assigned role</label>
                                                        <select name="roleId" class="form-select jy-form-control">
                                                            @foreach (var r in allRoles)
                                                            {
                                                                <option value="@r.RoleId" selected="@(user.RoleId == r.RoleId)">@r.RoleName</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer" style="border-top: 1px solid var(--jy-border); padding: 12px 20px; background-color: var(--jy-sidebar-bg);">
                                                <button type="button" class="jy-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="jy-btn-primary">Save changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

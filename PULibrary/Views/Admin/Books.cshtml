@model PULibrary.Models.BookCatalogViewModel
@{
    ViewData["Title"] = "Books";
}

<div class="jy-page-heading">
    <div class="jy-section-label">INVENTORY / TITLES & EDITIONS</div>
    <div class="jy-title-row">
        <h1 class="jy-page-title">Book catalog register.</h1>
        <button type="button" class="jy-btn-primary" data-bs-toggle="modal" data-bs-target="#addBookModal">
            + Add a book
        </button>
    </div>
    <div class="jy-page-subtitle">Search titles, ISBNs and linked catalog metadata. Availability comes from physical copies.</div>
</div>

<!-- Search & filter bar -->
<div class="jy-panel" style="padding: 16px 20px;">
    <form method="get" asp-action="Books" class="d-flex flex-column gap-3">
        <!-- Search field & button -->
        <div class="d-flex gap-3 align-items-center">
            <div class="input-group" style="flex: 1;">
                <span class="input-group-text" style="background-color:#fffdf8; border-color:var(--jy-border);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6c746b" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </span>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control jy-form-control" placeholder="Search by title, ISBN, or linked author..." />
            </div>
            <button type="submit" class="jy-btn-primary" style="height: 42px;">Search</button>
        </div>

        <!-- Filters row -->
        <div class="d-flex gap-3 align-items-center flex-wrap" style="font-size: 13px;">
            <div class="d-flex align-items-center gap-2">
                <span style="color: var(--jy-text-muted); font-weight: 600;">Category:</span>
                <select name="category" onchange="this.form.submit()" class="form-select jy-form-control p-1 px-2" style="font-size: 13px; width: auto;">
                    <option value="All">All Categories</option>
                    @foreach (var c in Model.AllCategories)
                    {
                        <option value="@c" selected="@(Model.SelectedCategory == c)">@c</option>
                    }
                </select>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span style="color: var(--jy-text-muted); font-weight: 600;">Language:</span>
                <select name="language" onchange="this.form.submit()" class="form-select jy-form-control p-1 px-2" style="font-size: 13px; width: auto;">
                    <option value="All">All Languages</option>
                    @foreach (var l in Model.AllLanguages)
                    {
                        <option value="@l" selected="@(Model.SelectedLanguage == l)">@l</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.SearchQuery) || (!string.IsNullOrEmpty(Model.SelectedCategory) && Model.SelectedCategory != "All") || (!string.IsNullOrEmpty(Model.SelectedLanguage) && Model.SelectedLanguage != "All"))
            {
                <a asp-action="Books" class="jy-btn-link ms-2" style="font-size: 13px;">Clear filters</a>
            }
        </div>
    </form>
</div>

<!-- Books Table -->
<div class="jy-panel">
    <div class="jy-panel-header d-flex justify-content-between align-items-center">
        <div>
            <div class="jy-panel-heading-title">Catalog collection</div>
            <div class="jy-panel-heading-desc">@Model.TotalBooksCount registered books across @Model.TotalPhysicalCopiesCount physical copies</div>
        </div>
        <div style="font-size: 13px; color: var(--jy-text-muted);">
            Page @Model.CurrentPage of @Model.TotalPages
        </div>
    </div>

    <div class="jy-table-container">
        <table class="jy-table">
            <thead>
                <tr>
                    <th style="width: 32%;">TITLE / ISBN</th>
                    <th style="width: 28%;">LINKED CATALOG METADATA</th>
                    <th style="width: 15%;">LANGUAGE / EDITION</th>
                    <th style="width: 12%;">COPIES</th>
                    <th style="width: 13%; text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Books.Any())
                {
                    @foreach (var book in Model.Books)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="jy-book-cover-thumb">
                                        <div class="jy-cover-title">@book.Title</div>
                                        <div class="jy-cover-rule"></div>
                                        <div class="jy-cover-author">@(book.Authors.FirstOrDefault() ?? "Author")</div>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; font-size: 15px; color: var(--jy-primary-green);">@book.Title</div>
                                        <div style="font-size: 12px; color: var(--jy-text-muted);">
                                            Book #@book.BookId @(book.Isbn != null ? $"· ISBN {book.Isbn}" : "")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 3px;">
                                    <div style="color: var(--jy-primary-green); font-size: 13px;">
                                        @(book.Authors.Any() ? string.Join(" · ", book.Authors) : "No author specified") ↗
                                    </div>
                                    <div style="color: var(--jy-text-muted); font-size: 12px;">
                                        @(book.Publishers.Any() ? string.Join(" · ", book.Publishers) : "No publisher") ↗
                                    </div>
                                    <div style="color: var(--jy-text-muted); font-size: 12px;">
                                        @(book.Categories.Any() ? string.Join(" · ", book.Categories) : "General") ↗
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 14px; color: var(--jy-primary-dark);">@book.Language</div>
                                <div style="font-size: 12px; color: var(--jy-text-muted);">Edition @book.Edition</div>
                            </td>
                            <td>
                                <div>
                                    <span class="jy-badge @(book.AvailableCopies > 0 ? "jy-badge-available" : "jy-badge-waiting")">
                                        <span class="jy-badge-dot"></span> @book.AvailableCopies of @book.TotalCopies
                                    </span>
                                    <div style="font-size: 11px; color: var(--jy-text-muted); margin-top: 2px;">available</div>
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <div class="d-flex justify-content-end align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none" style="color: var(--jy-primary-green); font-size: 13px; font-weight: 600;" 
                                            onclick="openEditBookModal(@book.BookId, @System.Text.Json.JsonSerializer.Serialize(book.Title), @System.Text.Json.JsonSerializer.Serialize(book.Isbn ?? ""), @System.Text.Json.JsonSerializer.Serialize(book.Language), @book.Edition, @System.Text.Json.JsonSerializer.Serialize(book.Authors.FirstOrDefault() ?? ""), @System.Text.Json.JsonSerializer.Serialize(book.Publishers.FirstOrDefault() ?? ""), @System.Text.Json.JsonSerializer.Serialize(book.Categories.FirstOrDefault() ?? ""))">
                                        Edit ✎
                                    </button>
                                    <span style="color: var(--jy-border);">|</span>
                                    <form asp-action="DeleteBook" method="post" class="d-inline" onsubmit="return confirm('Delete book &quot;@book.Title&quot;? All associated physical copies and history will be removed.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@book.BookId" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 13px; font-weight: 600;">
                                            Delete ✕
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No books match your criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center p-3" style="border-top: 1px solid var(--jy-border);">
            <div style="font-size: 13.5px; color: var(--jy-text-muted);">
                Showing <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)–@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalBooksCount))</strong> of <strong>@Model.TotalBooksCount</strong> books
            </div>
            <div class="d-flex gap-1 align-items-center">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="Books" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchQuery" asp-route-category="@Model.SelectedCategory" asp-route-language="@Model.SelectedLanguage" class="jy-btn-secondary" style="height: 36px; padding: 0 14px; font-size: 13px;">← Previous</a>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <a asp-action="Books" asp-route-page="@i" asp-route-search="@Model.SearchQuery" asp-route-category="@Model.SelectedCategory" asp-route-language="@Model.SelectedLanguage" class="@(i == Model.CurrentPage ? "jy-btn-primary" : "jy-btn-secondary")" style="height: 36px; min-width: 36px; padding: 0 10px; font-size: 13px; display: inline-flex; align-items: center; justify-content: center;">@i</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="Books" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchQuery" asp-route-category="@Model.SelectedCategory" asp-route-language="@Model.SelectedLanguage" class="jy-btn-secondary" style="height: 36px; padding: 0 14px; font-size: 13px;">Next →</a>
                }
            </div>
        </div>
    }
</div>

<!-- Modal: Add a Book -->
<div class="modal fade" id="addBookModal" tabindex="-1" aria-labelledby="addBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--jy-card-bg); border: 1px solid var(--jy-border); border-radius: 10px; box-shadow: 0 20px 48px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                <h5 class="modal-title" id="addBookModalLabel" style="font-family: var(--font-heading); color: var(--jy-primary-dark); margin: 0;">Add New Book to Collection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddBook" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body d-flex flex-column gap-3" style="padding: 24px;">
                    <div>
                        <label class="jy-form-label">Book Title *</label>
                        <input type="text" name="title" required class="form-control jy-form-control" placeholder="e.g. Modern Software Engineering" />
                    </div>
                    <div class="row g-2">
                        <div class="col-7">
                            <label class="jy-form-label">ISBN-13 (optional)</label>
                            <input type="text" name="isbn" maxlength="13" class="form-control jy-form-control" placeholder="978xxxxxxxxxx" />
                        </div>
                        <div class="col-5">
                            <label class="jy-form-label">Edition</label>
                            <input type="number" name="edition" value="1" min="1" class="form-control jy-form-control" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="jy-form-label">Language</label>
                            <select name="language" class="form-select jy-form-control">
                                <option value="English">English</option>
                                <option value="Chinese">Chinese</option>
                                <option value="Vietnamese">Vietnamese</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="jy-form-label">Category</label>
                            <input type="text" name="categoryName" class="form-control jy-form-control" placeholder="e.g. Computer Science" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="jy-form-label">Author Name</label>
                            <input type="text" name="authorName" class="form-control jy-form-control" placeholder="e.g. Martin Fowler" />
                        </div>
                        <div class="col-6">
                            <label class="jy-form-label">Publisher</label>
                            <input type="text" name="publisherName" class="form-control jy-form-control" placeholder="e.g. Addison-Wesley" />
                        </div>
                    </div>
                    <div>
                        <label class="jy-form-label">Description (optional)</label>
                        <textarea name="description" rows="2" class="form-control jy-form-control" placeholder="Brief synopsis or bibliographic notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--jy-border); padding: 16px 24px;">
                    <button type="button" class="jy-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jy-btn-primary">Save Book</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit a Book -->
<div class="modal fade" id="editBookModal" tabindex="-1" aria-labelledby="editBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: var(--jy-card-bg); border: 1px solid var(--jy-border); border-radius: 10px; box-shadow: 0 20px 48px rgba(0,0,0,0.18);">
            <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                <h5 class="modal-title" id="editBookModalLabel" style="font-family: var(--font-heading); color: var(--jy-primary-dark); margin: 0;">Edit Book Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateBook" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editBookId" name="bookId" value="" />
                <div class="modal-body d-flex flex-column gap-3" style="padding: 24px;">
                    <div>
                        <label class="jy-form-label">Book Title *</label>
                        <input type="text" id="editBookTitle" name="title" required class="form-control jy-form-control" />
                    </div>
                    <div class="row g-2">
                        <div class="col-7">
                            <label class="jy-form-label">ISBN-13 (optional)</label>
                            <input type="text" id="editBookIsbn" name="isbn" maxlength="13" class="form-control jy-form-control" />
                        </div>
                        <div class="col-5">
                            <label class="jy-form-label">Edition</label>
                            <input type="number" id="editBookEdition" name="edition" min="1" class="form-control jy-form-control" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="jy-form-label">Language</label>
                            <select id="editBookLanguage" name="language" class="form-select jy-form-control">
                                <option value="English">English</option>
                                <option value="Chinese">Chinese</option>
                                <option value="Vietnamese">Vietnamese</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="jy-form-label">Category</label>
                            <input type="text" id="editBookCategory" name="categoryName" class="form-control jy-form-control" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="jy-form-label">Author Name</label>
                            <input type="text" id="editBookAuthor" name="authorName" class="form-control jy-form-control" />
                        </div>
                        <div class="col-6">
                            <label class="jy-form-label">Publisher</label>
                            <input type="text" id="editBookPublisher" name="publisherName" class="form-control jy-form-control" />
                        </div>
                    </div>
                    <div>
                        <label class="jy-form-label">Description (optional)</label>
                        <textarea id="editBookDescription" name="description" rows="2" class="form-control jy-form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--jy-border); padding: 16px 24px;">
                    <button type="button" class="jy-btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jy-btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditBookModal(bookId, title, isbn, language, edition, author, publisher, category) {
            document.getElementById('editBookId').value = bookId;
            document.getElementById('editBookTitle').value = title;
            document.getElementById('editBookIsbn').value = isbn || '';
            document.getElementById('editBookLanguage').value = language || 'English';
            document.getElementById('editBookEdition').value = edition || 1;
            document.getElementById('editBookAuthor').value = author || '';
            document.getElementById('editBookPublisher').value = publisher || '';
            document.getElementById('editBookCategory').value = category || '';
            
            var modal = new bootstrap.Modal(document.getElementById('editBookModal'));
            modal.show();
        }
    </script>
}

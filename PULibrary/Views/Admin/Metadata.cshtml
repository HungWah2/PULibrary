@section Scripts {
    <script>
        function openEditAuthorModal(id, name) {
            document.getElementById('editAuthorId').value = id;
            document.getElementById('editAuthorName').value = name;
            var modal = new bootstrap.Modal(document.getElementById('editAuthorModal'));
            modal.show();
        }

        function openEditPublisherModal(id, name) {
            document.getElementById('editPublisherId').value = id;
            document.getElementById('editPublisherName').value = name;
            var modal = new bootstrap.Modal(document.getElementById('editPublisherModal'));
            modal.show();
        }

        function openEditCategoryModal(id, name) {
            document.getElementById('editCategoryId').value = id;
            document.getElementById('editCategoryName').value = name;
            var modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
            modal.show();
        }
    </script>
}

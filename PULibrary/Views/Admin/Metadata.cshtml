            <form asp-action="UpdateCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCategoryId" name="categoryId" value="" />
                <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title" style="font-family: 'Lora', serif; font-size: 20px; font-weight: 600; color: var(--jy-primary-dark); margin: 0;">Edit Category</h5>
                        <p style="font-size: 13px; color: var(--jy-text-muted); margin: 4px 0 0 0;">Update category title across all catalog taxonomy.</p>

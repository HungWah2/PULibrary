    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #fffdf8; border: 1px solid var(--jy-border); border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12);">
            <form asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title" style="font-family: 'Lora', serif; font-size: 20px; font-weight: 600; color: var(--jy-primary-dark); margin: 0;">Add Category</h5>
                        <p style="font-size: 13px; color: var(--jy-text-muted); margin: 4px 0 0 0;">Create a new subject classification category.</p>

@{
    ViewData["Title"] = "Catalog metadata";
    var authors = ViewBag.Authors as List<PULibrary.Models.Author> ?? new();
    var publishers = ViewBag.Publishers as List<PULibrary.Models.Publisher> ?? new();
    var categories = ViewBag.Categories as List<PULibrary.Models.Category> ?? new();
}

<div class="jy-page-heading">
    <div class="jy-section-label">CLASSIFICATION & AUTHORITY FILES</div>
    <div class="jy-title-row">
        <h1 class="jy-page-title">Catalog metadata management.</h1>
        <a asp-action="Books" class="jy-btn-secondary">Book catalog →</a>
    </div>
    <div class="jy-page-subtitle">Maintain authority records for authors, publishers, and subject categories linked to books.</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background-color: #d1e7dd; border-color: #badbcc; color: #0f5132; border-radius: 6px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background-color: #f8d7da; border-color: #f5c2c7; color: #842029; border-radius: 6px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Authors -->
    <div class="col-md-4">
        <div class="jy-panel">
            <div class="jy-panel-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="jy-panel-heading-title">Authors</div>
                    <div class="jy-panel-heading-desc">@authors.Count authors registered</div>
                </div>
                <button type="button" class="jy-btn-primary" style="height: 32px; padding: 0 12px; font-size: 13px; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#addAuthorModal">
                    + Add
                </button>
            </div>
            <div class="jy-table-container">
                <table class="jy-table">
                    <thead>
                        <tr>
                            <th>AUTHOR</th>
                            <th>BOOKS</th>
                            <th style="text-align: right; width: 90px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!authors.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-muted text-center py-3">No authors found.</td>
                            </tr>
                        }
                        @foreach (var a in authors)
                        {
                            <tr>
                                <td style="font-weight: 500; color: var(--jy-primary-dark);">@a.AuthorName</td>
                                <td style="font-size: 12px; color: var(--jy-primary-green);">@a.AssociateBookAuthors.Count title(s)</td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button type="button" class="btn btn-sm btn-link p-0 me-2 text-decoration-none" style="color: var(--jy-primary-green); font-size: 13px; font-weight: 600;" onclick="openEditAuthorModal(@a.AuthorId, @System.Text.Json.JsonSerializer.Serialize(a.AuthorName))">
                                        Edit
                                    </button>
                                    <form asp-action="DeleteAuthor" method="post" class="d-inline" onsubmit="return confirm('Delete author &quot;@a.AuthorName&quot;?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="authorId" value="@a.AuthorId" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 13px; font-weight: 600;">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Publishers -->
    <div class="col-md-4">
        <div class="jy-panel">
            <div class="jy-panel-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="jy-panel-heading-title">Publishers</div>
                    <div class="jy-panel-heading-desc">@publishers.Count publishers registered</div>
                </div>
                <button type="button" class="jy-btn-primary" style="height: 32px; padding: 0 12px; font-size: 13px; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#addPublisherModal">
                    + Add
                </button>
            </div>
            <div class="jy-table-container">
                <table class="jy-table">
                    <thead>
                        <tr>
                            <th>PUBLISHER</th>
                            <th>BOOKS</th>
                            <th style="text-align: right; width: 90px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!publishers.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-muted text-center py-3">No publishers found.</td>
                            </tr>
                        }
                        @foreach (var p in publishers)
                        {
                            <tr>
                                <td style="font-weight: 500; color: var(--jy-primary-dark);">@p.PublisherName</td>
                                <td style="font-size: 12px; color: var(--jy-primary-green);">@p.AssociateBookPublishers.Count title(s)</td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button type="button" class="btn btn-sm btn-link p-0 me-2 text-decoration-none" style="color: var(--jy-primary-green); font-size: 13px; font-weight: 600;" onclick="openEditPublisherModal(@p.PublisherId, @System.Text.Json.JsonSerializer.Serialize(p.PublisherName))">
                                        Edit
                                    </button>
                                    <form asp-action="DeletePublisher" method="post" class="d-inline" onsubmit="return confirm('Delete publisher &quot;@p.PublisherName&quot;?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="publisherId" value="@p.PublisherId" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 13px; font-weight: 600;">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Categories -->
    <div class="col-md-4">
        <div class="jy-panel">
            <div class="jy-panel-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="jy-panel-heading-title">Categories</div>
                    <div class="jy-panel-heading-desc">@categories.Count subject categories</div>
                </div>
                <button type="button" class="jy-btn-primary" style="height: 32px; padding: 0 12px; font-size: 13px; font-weight: 600;" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    + Add
                </button>
            </div>
            <div class="jy-table-container">
                <table class="jy-table">
                    <thead>
                        <tr>
                            <th>CATEGORY</th>
                            <th>BOOKS</th>
                            <th style="text-align: right; width: 90px;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!categories.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-muted text-center py-3">No categories found.</td>
                            </tr>
                        }
                        @foreach (var c in categories)
                        {
                            <tr>
                                <td style="font-weight: 500; color: var(--jy-primary-dark);">@c.CategoryName</td>
                                <td style="font-size: 12px; color: var(--jy-primary-green);">@c.AssociateBookCategories.Count title(s)</td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button type="button" class="btn btn-sm btn-link p-0 me-2 text-decoration-none" style="color: var(--jy-primary-green); font-size: 13px; font-weight: 600;" onclick="openEditCategoryModal(@c.CategoryId, @System.Text.Json.JsonSerializer.Serialize(c.CategoryName))">
                                        Edit
                                    </button>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Delete category &quot;@c.CategoryName&quot;?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" style="font-size: 13px; font-weight: 600;">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ==================== AUTHOR MODALS ==================== -->
<!-- Add Author Modal -->
<div class="modal fade" id="addAuthorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #fffdf8; border: 1px solid var(--jy-border); border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12);">
            <form asp-action="AddAuthor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title" style="font-family: 'Lora', serif; font-size: 20px; font-weight: 600; color: var(--jy-primary-dark); margin: 0;">Add Author</h5>
                        <p style="font-size: 13px; color: var(--jy-text-muted); margin: 4px 0 0 0;">Create a new authority record for book authorship.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--jy-text-muted);">Author Name *</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Robin Wall Kimmerer" maxlength="30" required style="border-radius: 6px; border-color: var(--jy-border); font-size: 14px; padding: 10px 12px;" />
                        <div class="form-text" style="font-size: 12px; color: var(--jy-text-muted);">Maximum 30 characters.</div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--jy-border); padding: 16px 24px; display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" class="jy-btn-secondary" style="height: 40px; padding: 0 20px; font-size: 14px; font-weight: 600;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jy-btn-primary" style="height: 40px; padding: 0 20px; font-size: 14px; font-weight: 600;">Add author</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Author Modal -->
<div class="modal fade" id="editAuthorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #fffdf8; border: 1px solid var(--jy-border); border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.12);">
            <form asp-action="UpdateAuthor" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editAuthorId" name="authorId" value="" />
                <div class="modal-header" style="border-bottom: 1px solid var(--jy-border); padding: 18px 24px;">
                    <div>
                        <h5 class="modal-title" style="font-family: 'Lora', serif; font-size: 20px; font-weight: 600; color: var(--jy-primary-dark); margin: 0;">Edit Author</h5>
                        <p style="font-size: 13px; color: var(--jy-text-muted); margin: 4px 0 0 0;">Update author record name across all linked titles.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--jy-text-muted);">Author Name *</label>
                        <input type="text" id="editAuthorName" name="name" class="form-control" maxlength="30" required style="border-radius: 6px; border-color: var(--jy-border); font-size: 14px; padding: 10px 12px;" />
                        <div class="form-text" style="font-size: 12px; color: var(--jy-text-muted);">Maximum 30 characters.</div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--jy-border); padding: 16px 24px; display: flex; justify-content: flex-end; gap: 12px;">
                    <button type="button" class="jy-btn-secondary" style="height: 40px; padding: 0 20px; font-size: 14px; font-weight: 600;" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="jy-btn-primary" style="height: 40px; padding: 0 20px; font-size: 14px; font-weight: 600;">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

